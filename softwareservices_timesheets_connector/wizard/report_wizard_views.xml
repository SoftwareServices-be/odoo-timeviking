<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_wizard_form" model="ir.ui.view">
        <field name="name">ss_timesheets.report_wizard.form</field>
        <field name="model">ss_timesheets.report_wizard</field>
        <field name="arch" type="xml">
            <form string="Print timesheet report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="employee_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="project_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </group>
                <p class="text-muted">One page per employee, in your company's document layout.
                    Hours logged in TimeViking are included: they are normal Odoo timesheets.</p>
                <footer>
                    <button name="action_print" type="object" string="Print report" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_report_wizard" model="ir.actions.act_window">
        <field name="name">Timesheet report</field>
        <field name="res_model">ss_timesheets.report_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_report_wizard" name="Timesheet Report (PDF)" parent="hr_timesheet.menu_timesheets_reports"
              action="action_report_wizard" groups="hr_timesheet.group_hr_timesheet_user" sequence="90"/>
</odoo>
