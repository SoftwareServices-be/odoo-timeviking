<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connection_form" model="ir.ui.view">
        <field name="name">ss_timesheets.connection.form</field>
        <field name="model">ss_timesheets.connection</field>
        <field name="arch" type="xml">
            <form string="{{PRODUCT_NAME}}" create="false" delete="false">
                <header>
                    <button name="action_pair" type="object" string="Pair" class="btn-primary" invisible="state == 'paired'"/>
                    <button name="action_test" type="object" string="Test" invisible="state != 'paired'"/>
                    <button name="action_unpair" type="object" string="Unpair" invisible="state != 'paired'"
                            confirm="The service will no longer be able to write timesheets in Odoo. Pairing again needs a new pairing code. Continue?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_links" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="link_count" widget="statinfo" string="Employees"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>{{PRODUCT_NAME}}</h1>
                    </div>
                    <div class="alert alert-success" role="status" invisible="state != 'paired'">
                        Paired with <field name="service_url" readonly="1" class="oe_inline"/>
                        since <field name="paired_at" readonly="1" class="oe_inline"/>.
                    </div>
                    <div class="alert alert-info" role="status" invisible="state == 'paired'">
                        In {{PRODUCT_NAME}}, go to Settings › Odoo, create a pairing code and paste it below.
                        The code is valid for 15 minutes.
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="service_url" readonly="state == 'paired'" placeholder="https://..."/>
                            <field name="odoo_url" readonly="state == 'paired'"/>
                            <field name="pair_code" invisible="state == 'paired'" placeholder="XXXX-XXXX-XXXX"/>
                            <field name="mode" readonly="1"/>
                        </group>
                        <group string="Scope">
                            <field name="company_ids" widget="many2many_tags" readonly="state == 'paired'"/>
                            <field name="connection_ref" invisible="state != 'paired'"/>
                            <field name="last_message"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employee_link_list" model="ir.ui.view">
        <field name="name">ss_timesheets.employee_link.list</field>
        <field name="model">ss_timesheets.employee_link</field>
        <field name="arch" type="xml">
            <list string="Linked employees" editable="bottom" create="false">
                <field name="employee_id" readonly="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="external_user"/>
                <field name="linked_at"/>
                <field name="allowed" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_employee_link_search" model="ir.ui.view">
        <field name="name">ss_timesheets.employee_link.search</field>
        <field name="model">ss_timesheets.employee_link</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <filter name="not_allowed" string="Not allowed" domain="[('allowed', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_open_connection" model="ir.actions.server">
        <field name="name">{{PRODUCT_NAME}}</field>
        <field name="model_id" ref="model_ss_timesheets_connection"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="action_employee_links" model="ir.actions.act_window">
        <field name="name">Linked employees</field>
        <field name="res_model">ss_timesheets.employee_link</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_root" name="{{PRODUCT_NAME}}" parent="base.menu_administration" sequence="90"
              groups="base.group_system"/>
    <menuitem id="menu_connection" name="Connection" parent="menu_root" action="action_open_connection" sequence="1"/>
    <menuitem id="menu_employee_links" name="Linked employees" parent="menu_root" action="action_employee_links" sequence="2"/>
</odoo>
