<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.ss_timesheets</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="timesheet_count" invisible="1"/>
                <button name="action_ss_attach_timesheet_report" type="object" string="Attach Timesheets"
                        invisible="not timesheet_count or move_type not in ('out_invoice', 'out_refund')"
                        groups="account.group_account_invoice"
                        help="Attach a PDF with the timesheets of this invoice (also added to the invoice email)"/>
            </xpath>
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="ss_timesheet_report_id" invisible="not ss_timesheet_report_id"/>
            </xpath>
        </field>
    </record>
</odoo>
